# =============================================================================
# Kaplun API — Environment Variables Template
# =============================================================================
# Copy this file to api/.env and fill in real values.
# api/.env is gitignored — never commit secrets.
#
# NOTE: The 6 automation table IDs below must be created manually in the
# Appwrite Console (TablesDB under the vernacular_saas database). There is
# no automated migration step for this.
# =============================================================================

# --- Clerk Auth ---
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=

# --- CORS ---
CORS_ORIGINS=https://kaplun.tech,https://www.kaplun.tech,http://localhost:8081

# --- Appwrite ---
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=vernacular_saas
APPWRITE_CREATORS_TABLE_ID=creators

# --- Instagram OAuth ---
IG_API_PORT=8000
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
REDIRECT_URI=https://your-ngrok-url.ngrok.io/instagram/callback

# --- Comment Automation — Appwrite Table IDs ---
# Create these tables manually in the Appwrite Console under vernacular_saas.
APPWRITE_AUTOMATIONS_TABLE_ID=
APPWRITE_AUTOMATION_LOGS_TABLE_ID=
APPWRITE_AUTOMATION_JOBS_TABLE_ID=
APPWRITE_TRACKED_LINKS_TABLE_ID=
APPWRITE_LINK_CLICKS_TABLE_ID=
APPWRITE_WEBHOOK_EVENTS_TABLE_ID=

# --- Comment Automation — Secrets ---
# WEBHOOK_VERIFY_TOKEN must be identical in the Meta Developer Portal webhook
# configuration and in the deployed api/.env.
WEBHOOK_VERIFY_TOKEN=
TOKEN_ENCRYPTION_KEY=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=
CRON_SECRET=
# PUBLIC_BASE_URL is the deployed production API host, e.g. https://api.kaplun.tech
PUBLIC_BASE_URL=
AUTOMATION_SWEEPER_ENABLED=true
