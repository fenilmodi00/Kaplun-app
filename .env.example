# Appwrite (Expo). Backend copies live in api-go/.env — do not put APPWRITE_API_KEY here.
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id

# Gin api-go base URL (auth bridge + automations). Must reach a live server:
# - Local emulator: http://10.0.2.2:<IG_API_PORT>  (Android) or http://localhost:<IG_API_PORT>
# - Physical device LAN: http://<your-lan-ip>:<IG_API_PORT>  (must match api-go IG_API_PORT)
# - Named Cloudflare tunnel (this project): https://api-dev.kaplun.tech
# Code default IG_API_PORT is 8000; this project's live api-go/.env uses 8001.
EXPO_PUBLIC_IG_API_BASE_URL=https://api-dev.kaplun.tech

# Instagram OAuth (Meta Developer Portal)
# EXPO_PUBLIC_IG_APP_ID must match backend INSTAGRAM_APP_ID (Instagram App ID from
# App Dashboard → Instagram → API setup with Instagram login, NOT the Facebook/Meta app id).
EXPO_PUBLIC_IG_APP_ID=your_instagram_app_id
EXPO_PUBLIC_IG_OAUTH_REDIRECT_URI=https://api-dev.kaplun.tech/instagram/callback
