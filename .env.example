# Clerk Authentication
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Appwrite
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_API_KEY=your_appwrite_api_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Gin api-go base URL (auth bridge + automations). Must reach a live server:
# - Local emulator: http://10.0.2.2:<IG_API_PORT>  (Android) or http://localhost:<IG_API_PORT>
# - Physical device LAN: http://<your-lan-ip>:<IG_API_PORT>  (must match api-go IG_API_PORT)
# - Prefer Cloudflare tunnel when running api-go with cloudflared: PUBLIC_BASE_URL
#   e.g. https://api-dev.kaplun.tech  (survives port/IP drift; requires tunnel up)
EXPO_PUBLIC_IG_API_BASE_URL=http://localhost:8000

# Instagram OAuth (Meta Developer Portal)
# IMPORTANT: EXPO_PUBLIC_IG_APP_ID and backend INSTAGRAM_APP_ID must BOTH be the
# Instagram App ID from App Dashboard → Instagram → API setup with Instagram login
# → Business login settings (NOT the Facebook/Meta app id).
EXPO_PUBLIC_IG_APP_ID=your_instagram_app_id
EXPO_PUBLIC_IG_API_PROXY_URL=https://ig-api-proxy.sgp.appwrite.run
EXPO_PUBLIC_IG_OAUTH_REDIRECT_URI=https://your-ngrok-or-host/instagram/callback
