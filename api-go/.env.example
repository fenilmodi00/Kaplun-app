# Kaplun API (Gin) — Environment Variables Template
# Copy to api-go/.env (gitignored) and fill in real values.

# --- Server ---
IG_API_PORT=8000
CORS_ORIGINS=https://kaplun.tech,https://www.kaplun.tech,http://localhost:8081
GIN_MODE=release

# --- Clerk Auth ---
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=

# --- Appwrite ---
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=vernacular_saas
APPWRITE_CREATORS_TABLE_ID=creators
APPWRITE_AUTOMATIONS_TABLE_ID=
APPWRITE_AUTOMATION_LOGS_TABLE_ID=
APPWRITE_AUTOMATION_JOBS_TABLE_ID=
APPWRITE_TRACKED_LINKS_TABLE_ID=
APPWRITE_LINK_CLICKS_TABLE_ID=
APPWRITE_WEBHOOK_EVENTS_TABLE_ID=

# --- Instagram OAuth ---
# Must be the Instagram App ID + Instagram App Secret from
# App Dashboard → Instagram → API setup with Instagram login → Business login settings.
# Do NOT use the Facebook/Meta app id here — it must match EXPO_PUBLIC_IG_APP_ID.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
REDIRECT_URI=https://your-host/instagram/callback

# --- Comment Automation ---
WEBHOOK_VERIFY_TOKEN=
TOKEN_ENCRYPTION_KEY=
FACEBOOK_APP_SECRET=
CRON_SECRET=
PUBLIC_BASE_URL=https://api.kaplun.tech
AUTOMATION_SWEEPER_ENABLED=true

# --- Local HTTPS tunnel (until production deploy) ---
# Cloudflare Tunnel is preferred: free ngrok serves an interstitial HTML page that
# breaks Meta webhook verification. Requires `cloudflared` on PATH.
# Quick tunnel (ephemeral *.trycloudflare.com): leave TOKEN empty.
# Cloudflare Tunnel for Meta webhooks (no free-ngrok interstitial).
CLOUDFLARE_TUNNEL_ENABLED=true
# Prefer CLI named tunnel (after: cloudflared tunnel create + route dns):
# CLOUDFLARE_TUNNEL_NAME=kaplun-api
# CLOUDFLARE_TUNNEL_URL=https://api-dev.kaplun.tech
# Or Zero Trust dashboard install token:
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_TUNNEL_URL=https://api.yourdomain.com
# Empty name+token = ephemeral trycloudflare.com quick tunnel.

# Optional legacy ngrok (defaults off — free ngrok breaks Meta webhook verify)
NGROK_ENABLED=false
# NGROK_DOMAIN=your-reserved.ngrok-free.dev
