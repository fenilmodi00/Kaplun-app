# Kaplun API (Gin) — Environment Variables Template
# Copy to api-go/.env (gitignored) and fill in real values.

# --- Server ---
IG_API_PORT=8000
CORS_ORIGINS=https://kaplun.tech,https://www.kaplun.tech,http://localhost:8081
GIN_MODE=release

# --- Clerk Auth ---
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=

# --- Appwrite ---
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=vernacular_saas
APPWRITE_CREATORS_TABLE_ID=creators
APPWRITE_AUTOMATIONS_TABLE_ID=
APPWRITE_AUTOMATION_LOGS_TABLE_ID=
APPWRITE_AUTOMATION_JOBS_TABLE_ID=
APPWRITE_TRACKED_LINKS_TABLE_ID=
APPWRITE_LINK_CLICKS_TABLE_ID=
APPWRITE_WEBHOOK_EVENTS_TABLE_ID=

# --- Instagram OAuth ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
REDIRECT_URI=https://your-host/instagram/callback

# --- Comment Automation ---
WEBHOOK_VERIFY_TOKEN=
TOKEN_ENCRYPTION_KEY=
FACEBOOK_APP_SECRET=
CRON_SECRET=
PUBLIC_BASE_URL=https://api.kaplun.tech
AUTOMATION_SWEEPER_ENABLED=true

# --- Local ngrok (default on until production deploy) ---
# Requires `ngrok` on PATH with an authtoken (`ngrok config add-authtoken ...`).
# Uses PUBLIC_BASE_URL as --url when it is an *.ngrok* host (same as FastAPI .env).
NGROK_ENABLED=true
# NGROK_DOMAIN=your-reserved.ngrok-free.dev
