# Kaplun API (Gin) — Environment Variables Template
# Copy to api-go/.env (gitignored) and fill in real values.

# --- Server ---
# Code default is 8000. This project's live .env uses 8001;
# named tunnel kaplun-api ingress is http://127.0.0.1:8001.
IG_API_PORT=8000
CORS_ORIGINS=https://kaplun.tech,https://www.kaplun.tech,http://localhost:8081

# --- Appwrite ---
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=vernacular_saas
APPWRITE_CREATORS_TABLE_ID=creators
APPWRITE_AUTOMATIONS_TABLE_ID=
APPWRITE_AUTOMATION_LOGS_TABLE_ID=
APPWRITE_AUTOMATION_JOBS_TABLE_ID=

# --- Instagram OAuth ---
# Must be the Instagram App ID + Instagram App Secret from
# App Dashboard → Instagram → API setup with Instagram login → Business login settings.
# Do NOT use the Facebook/Meta app id here — it must match EXPO_PUBLIC_IG_APP_ID.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
REDIRECT_URI=https://api-dev.kaplun.tech/instagram/callback

# --- Comment Automation ---
WEBHOOK_VERIFY_TOKEN=
# Meta App Secret from Settings → Basic. Instagram Login OAuth uses INSTAGRAM_APP_SECRET;
# webhook HMAC (x-hub-signature-256) uses FACEBOOK_APP_SECRET.
FACEBOOK_APP_SECRET=
# Local diagnosis only — never enable in production.
# WEBHOOK_INSECURE_SKIP_SIGNATURE=false
CRON_SECRET=
PUBLIC_BASE_URL=https://api-dev.kaplun.tech
AUTOMATION_SWEEPER_ENABLED=true
# Worker pool tuning (defaults shown). Raise workers only after checking
# downstream Meta/Appwrite rate limits — the pool is a bulkhead.
# WORKER_POOL_SIZE=4
# WORKER_QUEUE_SIZE=64
# SWEEPER_INTERVAL_MS=60000
# First-party Instagram Insights sync (in-process daily loop + backfill on boot)
INSIGHTS_SYNC_ENABLED=false
APPWRITE_CREATOR_MEDIA_TABLE_ID=
APPWRITE_CREATOR_INSIGHT_DAYS_TABLE_ID=
APPWRITE_CREATOR_AUDIENCE_DEMOGRAPHICS_TABLE_ID=
APPWRITE_CREATOR_ONLINE_FOLLOWERS_TABLE_ID=
APPWRITE_MENTIONED_MEDIA_TABLE_ID=
# Comment + button-tap reconcile poll interval (ms). Default 300000 (5m). Use 5000 for local.
# Button taps are reconciled from Instagram Conversations (postback webhooks are unreliable).
# Read in cmd/server/adapters.go, not config.go.
COMMENT_POLL_INTERVAL_MS=5000

# --- Cloudflare Tunnel ---
# Prefer a named tunnel so Meta OAuth/webhooks keep a stable hostname.
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_TUNNEL_NAME=kaplun-api
CLOUDFLARE_TUNNEL_URL=https://api-dev.kaplun.tech
# Or Zero Trust dashboard install token (must be the full token; leave unset when using NAME).
# Never put a comment/placeholder on the TOKEN= line — short junk values break named-tunnel startup.
# CLOUDFLARE_TUNNEL_TOKEN=
# Empty name+token = ephemeral *.trycloudflare.com quick tunnel.

# --- Profile Score reports ---
# LLM keys live ONLY on api-go. The Expo app never sees them.
# Any OpenAI-compatible /chat/completions endpoint works.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
APPWRITE_PROFILE_REPORTS_TABLE_ID=profile_reports
